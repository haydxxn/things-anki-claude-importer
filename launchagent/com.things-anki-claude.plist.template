<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.things-anki-claude</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd "__REPO_DIR__" &amp;&amp; /usr/bin/env npm run dev</string>
    </array>

    <!-- Run every 2 hours (7200 seconds); adjust as desired -->
    <key>StartInterval</key>
    <integer>7200</integer>

    <key>EnvironmentVariables</key>
    <dict>
      <!-- Choose ONE of these -->
      <key>ANTHROPIC_API_KEY</key>
      <string>PUT_YOUR_KEY_HERE</string>

      <!-- Or OpenRouter -->
      <!--
      <key>LLM_PROVIDER</key>
      <string>openrouter</string>
      <key>OPENROUTER_API_KEY</key>
      <string>PUT_YOUR_KEY_HERE</string>
      -->

      <!-- Optional overrides -->
      <key>ANKI_DECK</key>
      <string>English Vocab</string>
      <key>ANKI_MODEL</key>
      <string>Basic</string>
      <key>ANKI_TAGS</key>
      <string>things,vocab</string>
      <key>THINGS_TAG_TO_WATCH</key>
      <string>Anki</string>
      <key>THINGS_TAG_PROCESSED</key>
      <string>Anki-Added</string>
      <key>LLM_PROVIDER</key>
      <string>anthropic</string>
      <key>LLM_MODEL</key>
      <string>claude-3-5-haiku-latest</string>
      <key>LLM_MAX_TOKENS</key>
      <string>350</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/things-anki-claude.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/things-anki-claude.err.log</string>

    <key>RunAtLoad</key>
    <true/>
  </dict>
</plist>

